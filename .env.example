# JSON array; new Dev Dashboard apps use Client Credentials Grant.
SHOPIFY_STORES_JSON=[{"name":"Main store","market":"US","store":"your-store.myshopify.com","clientId":"your-client-id","clientSecret":"your-client-secret","feishuWebhookUrl":"https://open.feishu.cn/open-apis/bot/v2/hook/xxx","timezone":"America/Los_Angeles","apiVersion":"2026-07"}]

# v1 播报周期：daily / rolling7 / weekly / monthly
REPORT_TYPE=daily

# --- v2 销售日播报（npm run report:v2）---
# today = 文档的"今日"口径（当日未结束时为部分日）；yesterday = 完整播报前一天
REPORT_DAY=today
# V2_COLLAPSIBLE=true
# DRY_RUN=false
# WRITE_SNAPSHOT=false
# SNAPSHOT_DIR=snapshots
